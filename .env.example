# ---------------------------------------------------------------------------
# Website build (read by Vite at build time; safe to be public)
# ---------------------------------------------------------------------------
VITE_SITE_URL=https://www.duruvasa.com
# Optional: send the contact form somewhere else (e.g. Formspree). Default is the built-in /api/enquiries.
VITE_CONTACT_ENDPOINT=
# Shown if sending fails, and used for the mailto fallback.
VITE_CONTACT_EMAIL=info@duruvasa.com
# Privacy-friendly analytics. Leave empty to keep analytics (and the consent banner) off.
VITE_PLAUSIBLE_DOMAIN=

# ---------------------------------------------------------------------------
# Server (read by `node server-dist/server/index.js`; on the VM put these in /etc/duruvasa.env, mode 600)
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4180
HOST=127.0.0.1
# Where the SQLite database, uploads, private files and backups live. Must be on persistent disk.
DATA_DIR=/var/lib/duruvasa
PUBLIC_URL=https://www.duruvasa.com
ADMIN_EMAIL=rajesh@duruvasa.com
# Number of reverse proxies in front of Node (Caddy = 1). Needed for correct client IPs and HTTPS cookies.
TRUST_PROXY=1
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
BACKUP_KEEP=14

# Email notifications + auto-replies via Resend (https://resend.com). Optional but recommended.
RESEND_API_KEY=
MAIL_FROM="DuRuVaSa CloudSec <noreply@duruvasa.com>"
NOTIFY_TO=info@duruvasa.com,rajesh@duruvasa.com
