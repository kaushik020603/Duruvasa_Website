{
  "name": "duruvasa-cloudsec",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsc -p server",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p server --noEmit",
    "server:build": "tsc -p server",
    "server": "node server-dist/server/index.js",
    "start": "node server-dist/server/index.js",
    "admin:link": "node server-dist/server/cli.js link",
    "admin:reset-2fa": "node server-dist/server/cli.js reset-2fa",
    "dev:all": "node scripts/dev-all.mjs",
    "e2e": "playwright test",
    "test:all": "npm test && npm run e2e",
    "audit:headers": "node scripts/check-headers.mjs",
    "audit:lighthouse": "lhci autorun --config=lighthouserc.json"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "simple-icons": "^16.34.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.13"
  }
}
